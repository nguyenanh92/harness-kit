{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "type": "object",
  "required": ["features"],
  "properties": {
    "active_feature": {
      "type": "string",
      "description": "id of the single feature currently in progress",
      "pattern": "^F-\\d+$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^F-\\d+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "done"]
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^F-\\d+$" }
          },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
